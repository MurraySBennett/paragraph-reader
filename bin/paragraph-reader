#!/usr/bin/env python3
"""Open text, TeX, or PDF one paragraph at a time in the local HTML reader."""

from __future__ import annotations

import html
import base64
import hashlib
import os
import re
import shutil
import subprocess
import sys
import webbrowser
from pathlib import Path

READER_HTML = Path(__file__).resolve().parents[1] / "dist" / "paragraph-reader.html"


def die(msg: str, code: int = 1) -> None:
    print(msg, file=sys.stderr)
    raise SystemExit(code)


def strip_tex(src: str) -> str:
    s = src.replace("\r\n", "\n").replace("\r", "\n")
    s = re.sub(r"(^|[^\\])%.*$", r"\1", s, flags=re.M)

    # Expand simple \newcommand{\name}{body} so letter macros resolve.
    defs: dict[str, str] = {}
    for m in re.finditer(
        r"\\(?:re)?newcommand\*?\{(\\?[a-zA-Z]+)\}\s*(?:\[[^\]]*\])?\s*\{([^{}]*)\}",
        s,
    ):
        name = m.group(1).lstrip("\\")
        defs[name] = m.group(2)

    begin = s.find(r"\begin{document}")
    end = s.find(r"\end{document}")
    if begin != -1:
        s = s[begin + len(r"\begin{document}") : None if end == -1 else end]

    for name, body in sorted(defs.items(), key=lambda kv: -len(kv[0])):
        pattern = r"\\" + name + r"(?:\s*\{\}|\\(?![a-zA-Z])|(?![a-zA-Z]))"
        s = re.sub(pattern, lambda _m, b=body: b, s)

    for env in (
        "document",
        "abstract",
        "quote",
        "quotation",
        "center",
        "flushleft",
        "flushright",
        "itemize",
        "enumerate",
        "description",
        "titlepage",
    ):
        s = s.replace(rf"\begin{{{env}}}", "\n\n").replace(rf"\end{{{env}}}", "\n\n")

    s = re.sub(
        r"\\(part|chapter|section|subsection|subsubsection|paragraph|subparagraph)\*?\{([^{}]*)\}",
        r"\n\n\2\n\n",
        s,
    )
    s = re.sub(r"\\item\b(?:\[[^\]]*\])?", "\n\n", s)

    keep = (
        "emph|textbf|textit|textrm|textsf|texttt|textsc|underline|"
        "mathrm|mathbf|mathit|text|mbox|hbox"
    )
    for _ in range(8):
        s = re.sub(rf"\\({keep})\*?{{([^{{}}]*)}}", r"\2", s)

    # Drop commands whose arguments are not prose.
    s = re.sub(
        r"\\(thispagestyle|pagestyle|pagenumbering|vspace|hspace|vskip|hskip|"
        r"setlength|addtolength|setcounter|includegraphics|Signature|ProvideAddress|"
        r"ProvideEmail|ProvidePhone|documentclass|usepackage|input|include|"
        r"noindent|maketitle|headrule|dotline|par|newpage|clearpage|linebreak|"
        r"newline|citep|cite|ref|eqref|label|url|href|email|orcidlink|"
        r"caption|footnote|thanks|date|today)\*?"
        r"(?:\[[^\]]*\]){0,2}(?:\{[^{}]*\})*",
        " ",
        s,
    )

    def keep_or_drop(m: re.Match[str]) -> str:
        inner = m.group(1)
        if re.fullmatch(r"[0-9./\\ ]+(?:cm|mm|pt|em|ex|in|bp|dd|pc|sp)?", inner.strip()):
            return " "
        if len(inner) > 120:
            return " "
        return inner

    s = re.sub(r"\\[a-zA-Z]+\*?(?:\[[^\]]*\]){0,2}\{([^{}]*)\}", keep_or_drop, s)
    s = re.sub(r"\\[a-zA-Z]+\*?", " ", s)
    s = re.sub(r"\\([$&%#_{}])", r"\1", s)
    s = s.replace(r"\~", " ").replace("~", " ")
    s = s.replace("---", "—").replace("--", "–")
    s = s.replace("``", '"').replace("''", '"').replace("`", "'")
    s = re.sub(r"\{\s*\}", "", s)
    s = re.sub(r"[{}]", "", s)
    s = re.sub(r"[ \t]+\n", "\n", s)
    s = re.sub(r"\n{3,}", "\n\n", s)
    s = re.sub(r"[ \t]{2,}", " ", s)
    s = s.replace("\\", "")
    return s.strip()


BARE_NUMBER = re.compile(r"^\s*\d{1,3}\s*$")
GUTTER = re.compile(r"^\s*\d{1,3}(?=\s{2})")
INDENT_STEP = 4
HEADING_CHARS = 70


def looks_line_numbered(rows: list[str]) -> bool:
    """Journal manuscripts number every row, so no row is ever blank.

    Requiring the counter to climb keeps a table column of bare figures from
    being mistaken for a line-number gutter.
    """
    bare = [int(row.strip()) for row in rows if BARE_NUMBER.match(row)]
    if len(rows) < 8 or len(bare) / len(rows) < 0.2:
        return False
    rising = sum(1 for a, b in zip(bare, bare[1:]) if b > a)
    return rising >= (len(bare) - 1) * 0.6


def head_key(text: str) -> str:
    return re.sub(r"\s+\d{1,4}$", "", text.strip()).upper()


def running_heads(pages: list[list[str]]) -> set[str]:
    counts: dict[str, int] = {}
    for rows in pages:
        first = next((row for row in rows if row.strip()), None)
        if first is None:
            continue
        key = head_key(first)
        if key:
            counts[key] = counts.get(key, 0) + 1
    threshold = max(2, -(-len(pages) // 2))
    return {key for key, count in counts.items() if count >= threshold}


def is_heading(text: str) -> bool:
    """Short, opens in capitals, and carries no sentence punctuation of its own."""
    return len(text) <= HEADING_CHARS and bool(re.match(r"[A-Z0-9]", text)) and not re.search(r"[.,;:!?-]$", text)


def layout_paragraphs(text: str) -> str:
    """Recover paragraphs from the first-line indent rather than from blank lines."""
    pages = [page.split("\n") for page in text.replace("\r\n", "\n").split("\f")]
    numbered = looks_line_numbered([row for page in pages for row in page])
    stripped = [
        [GUTTER.sub("", row) if numbered else row for row in page if not (numbered and BARE_NUMBER.match(row))]
        for page in pages
    ]
    heads = running_heads(stripped)

    paragraphs: list[str] = []
    current: list[str] = []

    def flush() -> None:
        if not current:
            return
        joined = current[0]
        for row in current[1:]:
            joined = joined + row if joined.endswith("-") else f"{joined} {row}"
        paragraphs.append(re.sub(r"\s{2,}", " ", joined).strip())
        current.clear()

    for page in stripped:
        # A running head is removed outright: a blank row ends a paragraph, a dropped head does not.
        rows = [row for row in page if not (row.strip() and head_key(row) in heads)]
        kept = [(len(row) - len(row.lstrip()), row.strip()) if row.strip() else None for row in rows]
        bodies = [row for row in kept if row]
        if not bodies:
            flush()
            continue
        indents = [indent for indent, _ in bodies]
        modal = max(sorted(set(indents)), key=lambda value: (indents.count(value), -value))
        for row in kept:
            if row is None:
                flush()
                continue
            indent, body = row
            if indent >= modal + INDENT_STEP:
                flush()
            elif current and is_heading(body) and re.search(r"[.!?:]$", current[-1]):
                flush()
            current.append(body)
    flush()
    return "\n\n".join(paragraph for paragraph in paragraphs if paragraph)


def read_pdf(path: Path) -> str:
    pdftotext = shutil.which("pdftotext")
    if not pdftotext:
        die("pdftotext not found. Install poppler-utils, then retry.")
    try:
        result = subprocess.run(
            [pdftotext, "-layout", str(path), "-"],
            check=False,
            capture_output=True,
            text=True,
        )
    except OSError as exc:
        die(f"Could not run pdftotext: {exc}")
    if result.returncode != 0:
        err = (result.stderr or "").strip() or "unknown error"
        die(f"Could not read {path.name}: {err}")
    text = result.stdout or ""
    if not text.strip():
        result = subprocess.run(
            [pdftotext, str(path), "-"],
            check=False,
            capture_output=True,
            text=True,
        )
        text = result.stdout or ""
    if not text.strip():
        die(f"{path.name} is empty, or has no extractable text.")
    return layout_paragraphs(text) or text


def load_text(path: Path) -> str:
    if not path.exists():
        die(f"File not found: {path}")
    if not path.is_file():
        die(f"Not a file: {path}")
    suffix = path.suffix.lower()
    if suffix == ".pdf":
        return read_pdf(path)
    try:
        raw = path.read_text(encoding="utf-8")
    except UnicodeDecodeError:
        raw = path.read_text(encoding="utf-8", errors="replace")
    except OSError as exc:
        die(f"Could not read {path}: {exc}")
    if not raw.strip():
        die(f"{path.name} is empty.")
    if suffix in {".tex", ".ltx"} or re.search(
        r"\\(documentclass|begin\{document\}|section\*?\{)", raw[:4000]
    ):
        return raw
    return raw


def build_page(source: Path, text: str) -> Path:
    if not READER_HTML.exists():
        die(f"Missing reader page: {READER_HTML}. Run npm run build in the paragraph-reader project.")
    template = READER_HTML.read_text(encoding="utf-8")
    payload = (
        '<script id="boot-text" type="text/plain" data-source="'
        + html.escape(source.name, quote=True)
        + '" data-encoding="base64" data-cli="true" data-prepared="'
        + ("false" if source.suffix.lower() in {".tex", ".ltx"} else "true")
        + '">'
        + base64.b64encode(text.encode("utf-8")).decode("ascii")
        + "</script>"
    )
    import re as _re

    page, n = _re.subn(
        r'<script id="boot-text" type="text/plain"[^>]*>.*?</script>',
        lambda _match: payload,
        template,
        count=1,
        flags=_re.S,
    )
    if n != 1:
        die("Could not find boot-text slot in paragraph-reader.html")
    cache = Path.home() / ".cache" / "paragraph-reader"
    cache.mkdir(mode=0o700, parents=True, exist_ok=True)
    digest = hashlib.sha256(text.encode("utf-8")).hexdigest()
    out = cache / f"{digest}.html"
    with open(out, "w", encoding="utf-8", opener=lambda path, flags: os.open(path, flags, 0o600)) as handle:
        handle.write(page)
    out.chmod(0o600)
    return out



def main(argv: list[str]) -> None:
    if len(argv) != 2 or argv[1] in {"-h", "--help"}:
        die(
            "Usage: paragraph-reader <file>\n"
            "  Accepts .pdf, .tex, .txt, .md (and similar text).\n"
            "  Opens the local paragraph reader in your browser.",
            code=0 if len(argv) == 2 and argv[1] in {"-h", "--help"} else 1,
        )
    path = Path(argv[1]).expanduser().resolve()
    text = load_text(path)
    page = build_page(path, text)
    uri = page.as_uri()
    opened = webbrowser.open(uri)
    if not opened:
        opener = shutil.which("xdg-open")
        if opener:
            subprocess.Popen(
                [opener, str(page)],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
        else:
            die(f"Built page at {page}, but could not open a browser.")
    print(f"Reading {path.name} → {page}")


if __name__ == "__main__":
    main(sys.argv)
